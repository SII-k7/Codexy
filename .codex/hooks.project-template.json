{
  "description": "Project-scoped template for syncing privacy-minimized Codex session state and a sanitized prompt window to the paired 回神 device.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\capture_prompt.cmd",
            "commandWindows": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\capture_prompt.cmd",
            "timeout": 5,
            "statusMessage": "Updating your private CLI track"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "commandWindows": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "timeout": 5,
            "statusMessage": "Notifying your paired phone"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "commandWindows": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "commandWindows": "C:\\Windows\\System32\\cmd.exe /d /s /c call F:\\codex\\attention-companion-app\\.codex\\hooks\\notify_mobile.cmd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
