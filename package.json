{
  "name": "codexy-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-device": "~57.0.1",
    "expo-notifications": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "web-push": "^3.6.7",
    "ws": "^7.5.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "relay": "node relay/server.mjs",
    "relay:lan": "node relay/server.mjs --host 0.0.0.0",
    "relay:claim": "node relay/claim-pairing.mjs",
    "relay:demo": "node relay/send-demo.mjs",
    "relay:test": "node --test relay/*.test.mjs",
    "preview:iphone": "expo start --web --lan --port 8084",
    "preview:qr": "node scripts/generate-test-qr.mjs",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-codexy.ps1",
    "setup:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-codexy.ps1 -Apply",
    "diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-codexy.ps1",
    "hooks:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-global-hooks.ps1 -Apply",
    "hooks:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-global-hooks.ps1 -Apply",
    "legacy:disable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/disable-legacy-attention-companion.ps1 -Apply",
    "release:check": "node scripts/release-readiness.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "private:configure": "node scripts/configure-private-pwa.mjs",
    "private:build": "npm run pwa:icons && node scripts/build-private-pwa.mjs",
    "private:prepare": "npm run private:configure && npm run private:build",
    "private:start": "node --env-file-if-exists=.env.local relay/server.mjs --host 127.0.0.1",
    "private:install-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-private-pwa-task.ps1",
    "private:remove-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-private-pwa-task.ps1",
    "control:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-launcher.ps1",
    "control:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-codex-launcher.ps1",
    "control:codexy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-controlled-codex.ps1",
    "control:probe": "node relay/probe-codex-control.mjs",
    "check": "npm run typecheck && npm run relay:test"
  },
  "private": true
}
