# Codexy mobile app. On a physical device, replace loopback with the
# computer's LAN IP, or use the private HTTPS origin created by Tailscale.
EXPO_PUBLIC_RELAY_URL=http://127.0.0.1:8797

# Local Relay. Use 0.0.0.0 only on a trusted LAN for physical-device testing.
CODEXY_RELAY_HOST=127.0.0.1
CODEXY_RELAY_PORT=8797
# Optional comma-separated development origins. Production PWA is same-origin.
CODEXY_ALLOWED_ORIGINS=
# Optional outbound connector; private JSON with hubUrl, hostId and token.
CODEXY_HUB_AGENT_CONFIG=
# Omit CODEXY_RELAY_STATE_FILE to use ~/.codex/codexy/relay-state.json.
CODEXY_WEB_ROOT=web-builds/latest
CODEXY_NODE_COMMAND=

# Phone-to-Codex control. App Server remains loopback-only; the phone never
# connects to this WebSocket directly.
CODEXY_CODEX_CONTROL=true
CODEXY_CODEX_APP_SERVER_URL=ws://127.0.0.1:4510
# Optional absolute path if codex.cmd is not available on the startup PATH.
CODEXY_CODEX_COMMAND=

# Generated locally by `npm run private:configure`; never commit the private key.
CODEXY_VAPID_SUBJECT=mailto:self@example.com
CODEXY_VAPID_PUBLIC_KEY=
CODEXY_VAPID_PRIVATE_KEY=

# Created after claiming the one-time pairing code.
CODEXY_RELAY_URL=http://127.0.0.1:8797/v1/events
CODEXY_RELAY_TOKEN=
CODEXY_PROJECT_ALIAS=Codex project
